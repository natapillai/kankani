{
  "name": "@natapillai/kankani",
  "version": "0.1.0",
  "description": "AI-assisted observability for Node.js — Express middleware, local dashboard, AI trace analysis via Claude.",
  "keywords": [
    "observability",
    "tracing",
    "spans",
    "express",
    "express-middleware",
    "dashboard",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "Natarajan Lekshmi Narayana Pillai",
  "license": "MIT",
  "homepage": "https://github.com/natapillai/kankani#readme",
  "bugs": {
    "url": "https://github.com/natapillai/kankani/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natapillai/kankani.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm dashboard:build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "example": "tsx --env-file=.env examples/basic.ts",
    "dashboard:dev": "pnpm -F kankani-dashboard dev",
    "dashboard:build": "pnpm -F kankani-dashboard build",
    "verify-tarball": "node scripts/verify-tarball.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1"
  }
}
